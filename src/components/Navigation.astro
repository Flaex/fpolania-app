---
import { useTranslations, getAlternatePath } from '../utils/i18n';
import logoDark from '../assets/fredy-polania-logo-dark.svg';
import logoLight from '../assets/fredy-polania-logo-light.svg';

const { pathname } = Astro.url;

// Detect active language from URL pathname, default to 'en'
const lang = pathname.startsWith('/es') ? 'es' : 'en';

const t = useTranslations(lang);

// Compute correct paths for active language
const homePath = `/${lang}/`;
const worksPath = lang === 'en' ? '/en/works' : '/es/trabajos';
const insightPath = lang === 'en' ? '/en/insight' : '/es/perspectivas';

// Determine active state based on route path
const isStrategy = pathname === '/en' || pathname === '/en/' || pathname === '/es' || pathname === '/es/';
const isWork = pathname.startsWith('/en/works') || pathname.startsWith('/es/trabajos');
const isInsight = pathname.startsWith('/en/insight') || pathname.startsWith('/es/perspectivas');

// For language selector: compute alternate paths
const alternateLang = lang === 'en' ? 'es' : 'en';
const alternatePath = getAlternatePath(pathname, alternateLang);

// Utility to apply classes conditionally
const activeClass = "font-body-md text-primary relative py-1 text-sm font-medium tracking-wide after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-px after:bg-primary";
const inactiveClass = "font-body-md text-on-surface-variant hover:text-primary transition-colors duration-200 text-sm font-medium tracking-wide";
---

<nav class="bg-surface border-b border-outline-variant/35 sticky top-0 z-50 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
            <div class="flex-shrink-0">
                <a href={homePath} class="flex items-center">
                    <img 
                        src={logoDark.src} 
                        alt="Fredy Polania Logo" 
                        class="h-8 w-auto dark-only"
                    />
                    <img 
                        src={logoLight.src} 
                        alt="Fredy Polania Logo" 
                        class="h-8 w-auto light-only"
                    />
                </a>
            </div>
            <div class="hidden md:flex items-center space-x-12 font-body-md">
                <a href={homePath} class={isStrategy ? activeClass : inactiveClass}>{t('nav.strategy')}</a>
                <a href={worksPath} class={isWork ? activeClass : inactiveClass}>{t('nav.work')}</a>
                <a href={insightPath} class={isInsight ? activeClass : inactiveClass}>{t('nav.insight')}</a>
            </div>
            <div class="flex items-center space-x-4">
                <!-- Theme Toggle -->
                <button 
                    id="theme-toggle" 
                    aria-label="Toggle Theme"
                    class="w-9 h-9 flex items-center justify-center border border-outline-variant rounded-full text-on-surface-variant hover:text-primary hover:border-primary transition-all duration-200 cursor-pointer"
                >
                    <span class="material-symbols-outlined text-lg dark-only">light_mode</span>
                    <span class="material-symbols-outlined text-lg light-only">dark_mode</span>
                </button>

                <!-- Language Switcher EN | ES -->
                <div class="font-label-technical text-label-technical flex space-x-2 items-center text-xs tracking-wider">
                    <a 
                        href={lang === 'en' ? '#' : alternatePath} 
                        class={`lang-btn hover:text-primary transition-colors py-1 ${lang === 'en' ? 'text-primary font-bold pointer-events-none' : 'text-on-surface-variant'}`}
                        data-lang="en"
                    >
                        EN
                    </a>
                    <span class="text-outline-variant">|</span>
                    <a 
                        href={lang === 'es' ? '#' : alternatePath} 
                        class={`lang-btn hover:text-primary transition-colors py-1 ${lang === 'es' ? 'text-primary font-bold pointer-events-none' : 'text-on-surface-variant'}`}
                        data-lang="es"
                    >
                        ES
                    </a>
                </div>
            </div>
        </div>
    </div>
</nav>

<script>
    const setupThemeToggle = () => {
        const toggleBtn = document.getElementById('theme-toggle');
        
        // Dynamic cleanup of legacy favicon element to force SVG usage
        const cleanLegacy = () => {
            const legacy = document.getElementById('legacy-favicon');
            if (legacy && legacy.parentNode) {
                legacy.parentNode.removeChild(legacy);
            }
        };
        cleanLegacy();

        if (!toggleBtn) return;
        
        toggleBtn.addEventListener('click', () => {
            cleanLegacy();
            const isLight = document.documentElement.classList.contains('light');
            const favicon = document.getElementById('dynamic-favicon') as HTMLLinkElement | null;
            
            let newTheme = 'dark';
            if (isLight) {
                document.documentElement.classList.remove('light');
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                newTheme = 'dark';
            } else {
                document.documentElement.classList.remove('dark');
                document.documentElement.classList.add('light');
                localStorage.setItem('theme', 'light');
                newTheme = 'light';
            }

            if (favicon) {
                // To force browser favicon reload: recreate the link element and add a timestamp cache-buster
                const newFavicon = favicon.cloneNode(true) as HTMLLinkElement;
                const baseHref = newTheme === 'light' ? '/favicon-light.svg' : '/favicon-dark.svg';
                newFavicon.href = `${baseHref}?t=${new Date().getTime()}`;
                if (favicon.parentNode) {
                    favicon.parentNode.replaceChild(newFavicon, favicon);
                }
            }
        });
    };

    // Run setup immediately
    setupThemeToggle();
    // Re-bind on Astro page transitions
    document.addEventListener('astro:after-swap', setupThemeToggle);

    // Language preference persistence
    document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const targetLang = btn.getAttribute('data-lang');
            if (targetLang) {
                localStorage.setItem('preferred-lang', targetLang);
            }
        });
    });
</script>
