---
import { useTranslations, getAlternatePath } from '../utils/i18n';
import logoDark from '../assets/fredy-polania-logo-dark.svg';
import logoLight from '../assets/fredy-polania-logo-light.svg';

const { pathname } = Astro.url;

// Detect active language from URL pathname, default to 'en'
const lang = pathname.startsWith('/es') ? 'es' : 'en';

const t = useTranslations(lang);

// Compute correct paths for active language
const homePath = `/${lang}/`;
const worksPath = lang === 'en' ? '/en/works' : '/es/trabajos';
const insightPath = lang === 'en' ? '/en/insight' : '/es/perspectivas';

// Determine active state based on route path
const isStrategy = pathname === '/en' || pathname === '/en/' || pathname === '/es' || pathname === '/es/';
const isWork = pathname.startsWith('/en/works') || pathname.startsWith('/es/trabajos');
const isInsight = pathname.startsWith('/en/insight') || pathname.startsWith('/es/perspectivas');

// For language selector: compute alternate paths
const alternateLang = lang === 'en' ? 'es' : 'en';
const alternatePath = getAlternatePath(pathname, alternateLang);

// Utility to apply classes conditionally
const activeClass = "font-body-md text-primary relative py-1 text-sm font-medium tracking-wide after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-full after:h-px after:bg-primary";
const inactiveClass = "font-body-md text-on-surface-variant hover:text-primary transition-colors duration-200 text-sm font-medium tracking-wide";
---

<nav class="bg-surface border-b border-outline-variant/35 sticky top-0 z-50 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-4 lg:px-10">
        <div class="flex justify-between items-center h-20">
            <div class="flex-shrink-0">
                <a href={homePath} class="flex items-center">
                    <img 
                        src={logoDark.src} 
                        alt="Fredy Polania Logo" 
                        class="h-[42px] w-auto dark-only"
                    />
                    <img 
                        src={logoLight.src} 
                        alt="Fredy Polania Logo" 
                        class="h-[42px] w-auto light-only"
                    />
                </a>
            </div>
            <div class="hidden md:flex items-center space-x-12 font-body-md">
                <a href={homePath} class={isStrategy ? activeClass : inactiveClass}>{t('nav.strategy')}</a>
                <a href={worksPath} class={isWork ? activeClass : inactiveClass}>{t('nav.work')}</a>
                <a href={insightPath} class={isInsight ? activeClass : inactiveClass}>{t('nav.insight')}</a>
            </div>
            <div class="flex items-center space-x-4">
                <!-- Theme Toggle -->
                <button 
                    id="theme-toggle" 
                    aria-label="Toggle Theme"
                    class="w-9 h-9 flex items-center justify-center border border-outline-variant rounded-full text-on-surface-variant hover:text-primary hover:border-primary transition-all duration-200 cursor-pointer"
                >
                    <span class="material-symbols-outlined text-lg dark-only">light_mode</span>
                    <span class="material-symbols-outlined text-lg light-only">dark_mode</span>
                </button>

                <!-- Language Switcher EN | ES -->
                <div class="font-label-technical text-label-technical flex space-x-2 items-center text-xs tracking-wider">
                    <a 
                        href={lang === 'en' ? '#' : alternatePath} 
                        class={`lang-btn hover:text-primary transition-colors py-1 ${lang === 'en' ? 'text-primary font-bold pointer-events-none' : 'text-on-surface-variant'}`}
                        data-lang="en"
                    >
                        EN
                    </a>
                    <span class="text-outline-variant">|</span>
                    <a 
                        href={lang === 'es' ? '#' : alternatePath} 
                        class={`lang-btn hover:text-primary transition-colors py-1 ${lang === 'es' ? 'text-primary font-bold pointer-events-none' : 'text-on-surface-variant'}`}
                        data-lang="es"
                    >
                        ES
                    </a>
                </div>
                
                <!-- Hamburger Menu Toggle Button -->
                <button
                    id="mobile-menu-toggle"
                    aria-label="Toggle Menu"
                    aria-expanded="false"
                    class="md:hidden w-9 h-9 flex items-center justify-center border border-outline-variant rounded-full text-on-surface-variant hover:text-primary hover:border-primary transition-all duration-200 cursor-pointer ml-2"
                >
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square">
                        <line x1="4" y1="6" x2="20" y2="6"></line>
                        <line x1="4" y1="12" x2="20" y2="12"></line>
                        <line x1="4" y1="18" x2="20" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>
    </div>
</nav>

<!-- Mobile Drawer Backdrop Overlay -->
<div 
    id="mobile-menu-backdrop" 
    class="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
></div>

<!-- Mobile Navigation Drawer -->
<div 
    id="mobile-menu-drawer" 
    class="fixed inset-y-0 right-0 z-50 w-full max-w-[320px] bg-surface border-l border-outline-variant p-6 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col"
>
    <div>
        <!-- Drawer Header -->
        <div class="flex justify-end items-center">
            <button 
                id="mobile-menu-close" 
                aria-label="Close Menu"
                class="w-9 h-9 flex items-center justify-center border border-outline-variant rounded-full text-on-surface-variant hover:text-primary hover:border-primary transition-all duration-200 cursor-pointer"
            >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <!-- Navigation Links Stack -->
        <div class="flex flex-col space-y-6">
            <a 
                href={homePath} 
                class="flex flex-col group py-2"
            >
                <span class="font-label-technical text-[10px] text-primary/40 uppercase tracking-wider mb-1">01</span>
                <span class={`font-display text-2xl font-bold font-fraunces transition-colors ${isStrategy ? 'text-primary' : 'text-primary/60 hover:text-primary'}`}>{t('nav.strategy')}</span>
            </a>
            <a 
                href={worksPath} 
                class="flex flex-col group py-2"
            >
                <span class="font-label-technical text-[10px] text-primary/40 uppercase tracking-wider mb-1">02</span>
                <span class={`font-display text-2xl font-bold font-fraunces transition-colors ${isWork ? 'text-primary' : 'text-primary/60 hover:text-primary'}`}>{t('nav.work')}</span>
            </a>
            <a 
                href={insightPath} 
                class="flex flex-col group py-2"
            >
                <span class="font-label-technical text-[10px] text-primary/40 uppercase tracking-wider mb-1">03</span>
                <span class={`font-display text-2xl font-bold font-fraunces transition-colors ${isInsight ? 'text-primary' : 'text-primary/60 hover:text-primary'}`}>{t('nav.insight')}</span>
            </a>
            
            <div class="pt-6 border-t border-outline-variant/50">
                <a 
                    href="mailto:fpolania@gmail.com" 
                    class="block w-full text-center font-body-md bg-primary text-on-primary py-3.5 px-6 text-xs font-bold uppercase tracking-widest hover:opacity-85 transition-all rounded-sm"
                >
                    {t('nav.connect')}
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    const setupThemeToggle = () => {
        const toggleBtn = document.getElementById('theme-toggle');
        
        // Dynamic cleanup of legacy favicon element to force SVG usage
        const cleanLegacy = () => {
            const legacy = document.getElementById('legacy-favicon');
            if (legacy && legacy.parentNode) {
                legacy.parentNode.removeChild(legacy);
            }
        };
        cleanLegacy();

        if (!toggleBtn) return;
        
        toggleBtn.addEventListener('click', () => {
            cleanLegacy();
            const isLight = document.documentElement.classList.contains('light');
            const favicon = document.getElementById('dynamic-favicon') as HTMLLinkElement | null;
            
            let newTheme = 'dark';
            if (isLight) {
                document.documentElement.classList.remove('light');
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
                newTheme = 'dark';
            } else {
                document.documentElement.classList.remove('dark');
                document.documentElement.classList.add('light');
                localStorage.setItem('theme', 'light');
                newTheme = 'light';
            }

            if (favicon) {
                // To force browser favicon reload: recreate the link element and add a timestamp cache-buster
                const newFavicon = favicon.cloneNode(true) as HTMLLinkElement;
                const baseHref = newTheme === 'light' ? '/favicon-light.svg' : '/favicon-dark.svg';
                newFavicon.href = `${baseHref}?t=${new Date().getTime()}`;
                if (favicon.parentNode) {
                    favicon.parentNode.replaceChild(newFavicon, favicon);
                }
            }
        });
    };

    const setupMobileMenu = () => {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const closeBtn = document.getElementById('mobile-menu-close');
        const drawer = document.getElementById('mobile-menu-drawer');
        const backdrop = document.getElementById('mobile-menu-backdrop');
        
        if (!toggleBtn || !drawer || !backdrop || !closeBtn) return;
        
        const openMenu = () => {
            drawer.classList.remove('translate-x-full');
            backdrop.classList.remove('pointer-events-none', 'opacity-0');
            backdrop.classList.add('opacity-100');
            toggleBtn.setAttribute('aria-expanded', 'true');
            document.body.style.overflow = 'hidden';
        };
        
        const closeMenu = () => {
            drawer.classList.add('translate-x-full');
            backdrop.classList.remove('opacity-100');
            backdrop.classList.add('opacity-0', 'pointer-events-none');
            toggleBtn.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
        };
        
        toggleBtn.addEventListener('click', openMenu);
        closeBtn.addEventListener('click', closeMenu);
        backdrop.addEventListener('click', closeMenu);
        
        // Handle Escape key
        const handleKeyDown = (e: KeyboardEvent) => {
            if (e.key === 'Escape') closeMenu();
        };
        document.addEventListener('keydown', handleKeyDown);
    };

    // Run setup immediately
    setupThemeToggle();
    setupMobileMenu();
    // Re-bind on Astro page transitions
    document.addEventListener('astro:after-swap', () => {
        setupThemeToggle();
        setupMobileMenu();
    });

    // Language preference persistence
    document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const targetLang = btn.getAttribute('data-lang');
            if (targetLang) {
                localStorage.setItem('preferred-lang', targetLang);
            }
        });
    });
</script>
