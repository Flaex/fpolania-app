---
import Layout from '../../../layouts/Layout.astro';
import Navigation from '../../../components/Navigation.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations, reverseSlugMap } from '../../../utils/i18n';

function toPhraseCase(str: string) {
    if (!str) return '';
    const lower = str.toLowerCase();
    const match = lower.match(/[a-zñáéíóúü]/i);
    if (match) {
        return lower.substring(0, match.index) + lower.charAt(match.index).toUpperCase() + lower.substring(match.index + 1);
    }
    return lower;
}

function formatDate(dateStr: string, lang: string) {
  if (!dateStr) return '';
  const parts = dateStr.split('-');
  if (parts.length !== 3) return dateStr;
  const [year, month, day] = parts;
  const dayNum = parseInt(day, 10);
  const monthNum = parseInt(month, 10) - 1;

  const monthsEs = [
    'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
    'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'
  ];
  const monthsEn = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December'
  ];

  if (lang === 'es') {
    const formattedDay = dayNum.toString().padStart(2, '0');
    return `${formattedDay} de ${monthsEs[monthNum]} de ${year}`;
  } else {
    return `${monthsEn[monthNum]} ${dayNum}, ${year}`;
  }
}

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  return posts.map(post => {
    const slug = post.id.split('/').pop()?.replace(/\.md$/, '') || '';
    const lang = post.data.language || 'en';
    const hub = lang === 'en' ? 'insight' : 'perspectivas';
    return {
      params: { lang, hub, slug },
      props: { post },
    };
  });
}

const { lang } = Astro.params;
const { post } = Astro.props;
const { Content } = await render(post);

const t = useTranslations(lang);

const getSlug = (id: string) => id.split('/').pop()?.replace(/\.md$/, '') || '';
const slug = getSlug(post.id);

// Compute read time dynamically
const wordCount = post.body ? post.body.split(/\s+/).length : 0;
const readTime = Math.ceil(wordCount / 200) || 5;

// Article metadata config mapping in both English & Spanish dynamically
const articleMetadata: Record<string, { index: string, date: string, category: string }> = {
  'everything-is-design-the-philosophy-of-utility': {
    index: '01',
    date: lang === 'en' ? 'May 10, 2026' : '10 de mayo de 2026',
    category: lang === 'en' ? 'Strategy / Business' : 'Estrategia / Negocios'
  },
  'the-logo-and-the-company-the-investment-in-trust': {
    index: '02',
    date: lang === 'en' ? 'May 12, 2026' : '12 de mayo de 2026',
    category: lang === 'en' ? 'Strategy / ROI' : 'Estrategia / ROI'
  },
  'the-value-of-graphic-design-a-strategic-perspective': {
    index: '03',
    date: lang === 'en' ? 'May 15, 2026' : '15 de mayo de 2026',
    category: lang === 'en' ? 'Strategy / Economics' : 'Estrategia / Economía'
  },
  'graphic-design-and-branding-the-authority-system': {
    index: '04',
    date: lang === 'en' ? 'May 18, 2026' : '18 de mayo de 2026',
    category: lang === 'en' ? 'Strategy / Brand' : 'Estrategia / Marca'
  },
  'what-is-typography-the-dna-of-information': {
    index: '05',
    date: lang === 'en' ? 'May 20, 2026' : '20 de mayo de 2026',
    category: lang === 'en' ? 'Visual / Identity' : 'Visual / Identidad'
  },
  'typographic-classification-the-geometry-of-tone': {
    index: '06',
    date: lang === 'en' ? 'May 22, 2026' : '22 de mayo de 2026',
    category: lang === 'en' ? 'Visual / Reference' : 'Visual / Referencia'
  },
  'the-logo-variants-strategic-adaptability': {
    index: '07',
    date: lang === 'en' ? 'May 24, 2026' : '24 de mayo de 2026',
    category: lang === 'en' ? 'Visual / System' : 'Visual / Sistema'
  },
  'visual-communication-or-graphic-design': {
    index: '08',
    date: lang === 'en' ? 'May 26, 2026' : '26 de mayo de 2026',
    category: lang === 'en' ? 'Visual / Philosophy' : 'Visual / Filosofía'
  },
  'illustrator-basics-precision-tools': {
    index: '09',
    date: lang === 'en' ? 'May 28, 2026' : '28 de mayo de 2026',
    category: lang === 'en' ? 'Visual / Mastery' : 'Visual / Maestría'
  },
  'what-is-the-utility-of-learning-html': {
    index: '10',
    date: lang === 'en' ? 'June 01, 2026' : '01 de junio de 2026',
    category: lang === 'en' ? 'Builder / Foundations' : 'Builder / Fundamentos'
  },
  'what-is-html-the-structure-of-information': {
    index: '11',
    date: lang === 'en' ? 'June 03, 2026' : '03 de junio de 2026',
    category: lang === 'en' ? 'Builder / HTML' : 'Builder / HTML'
  },
  'what-is-css-the-visual-style-system': {
    index: '12',
    date: lang === 'en' ? 'June 05, 2026' : '05 de junio de 2026',
    category: lang === 'en' ? 'Builder / CSS' : 'Builder / CSS'
  },
  'the-translation-gap-in-digital-products': {
    index: '13',
    date: lang === 'en' ? 'June 08, 2026' : '08 de junio de 2026',
    category: lang === 'en' ? 'Builder / Execution' : 'Builder / Ejecución'
  }
};

const enSlugKey = lang === 'es' ? reverseSlugMap[slug] : slug;
const meta = articleMetadata[enSlugKey] || { index: '00', date: lang === 'en' ? 'May 2026' : 'Mayo 2026', category: lang === 'en' ? 'Insight' : 'Perspectiva' };

// Fetch related posts (excluding the current one)
const allPosts = await getCollection('blog', ({ data }) => data.language === lang);
const relatedPosts = allPosts
  .filter(p => getSlug(p.id) !== slug)
  .slice(0, 2);

const hubPath = lang === 'en' ? '/en/insight' : '/es/perspectivas';
const metaTitleSuffix = t('article.metaSuffix');

// Resolve dynamic description / summary from dictionary or fallback to title + default desc
const summaryKey = `summaries.${slug}`;
let description = t(summaryKey, "NO_SUMMARY");
if (description === "NO_SUMMARY" || description === summaryKey) {
  description = `${toPhraseCase(post.data.title)}. ${t("insight.metaDescription")}`;
}

const ogImage = post.data.image || "/icon-512.png";
const canonicalUrl = `https://fpolania.com${Astro.url.pathname}`;
const articleImage = ogImage.startsWith('http') ? ogImage : `https://fpolania.com${ogImage}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": lang === 'es' ? "Inicio" : "Home",
          "item": `https://fpolania.com/${lang}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": lang === 'es' ? "Perspectivas" : "Insight",
          "item": `https://fpolania.com${hubPath}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": toPhraseCase(post.data.title),
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "headline": toPhraseCase(post.data.title),
      "description": description,
      "image": articleImage,
      "datePublished": post.data.date,
      "dateModified": post.data.date,
      "mainEntityOfPage": canonicalUrl,
      "inLanguage": lang,
      "author": {
        "@type": "Person",
        "name": "Fredy Polania",
        "jobTitle": "Senior Product Strategist",
        "url": "https://fpolania.com/",
        "sameAs": [
          "https://www.linkedin.com/in/freddypolania/",
          "https://www.behance.net/fredypolania",
          "https://x.com/Flaex_"
        ]
      },
      "publisher": {
        "@type": "Organization",
        "name": "Fredy Polania",
        "url": "https://fpolania.com/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://fpolania.com/icon-512.png"
        }
      }
    }
  ]
};
---

<Layout 
  title={`${toPhraseCase(post.data.title)} | ${metaTitleSuffix}`} 
  description={description} 
  image={ogImage} 
  type="article" 
  lang={lang}
  schema={articleSchema}
>
  <div class="grain"></div>
  
  <Navigation />
  
  <main class="max-w-[800px] mx-auto px-margin-mobile md:px-0 pt-6 pb-6 md:pb-12 md:pt-6">
    <!-- Header -->
    <header class="mb-8">
      <div class="flex items-center space-x-3 mb-6">
        <span class="font-label-technical text-label-technical text-secondary px-2 py-1 border border-outline-variant uppercase">
          {lang === 'en' ? 'Insight' : 'Perspectiva'} / {meta.index}
        </span>
        <span class="font-label-technical text-label-technical text-secondary uppercase tracking-widest text-xs">
          {formatDate(post.data.date, lang)} — {readTime} {t('article.readTimeSuffix')}
        </span>
      </div>
      <h1 class="font-display text-[40px] md:text-display mb-8 text-primary font-fraunces leading-tight">
        {toPhraseCase(post.data.title)}
      </h1>
      <div class="flex items-center pt-8 border-t border-outline-variant">
        <img 
          alt="Fredy Polania" 
          class="w-12 h-12 rounded-full grayscale border border-outline" 
          src="https://res.cloudinary.com/flaex/image/upload/v1780509567/fpolania-app/fpolania-perfil-46x46.webp"
        />
        <div class="ml-4">
          <p class="font-label-technical text-label-technical text-primary uppercase font-bold">Fredy Polania</p>
          <p class="font-label-technical text-label-technical text-secondary">{t('article.authorTitle')}</p>
        </div>
      </div>
    </header>

    <!-- Framed High-Density Image Card -->
    {post.data.image && (
      <div class="w-full border border-outline-variant bg-surface-container-low mb-16 aspect-[1376/768] overflow-hidden relative group">
        <img 
          src={post.data.image} 
          alt={post.data.title} 
          width="1376"
          height="768"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-carbon/5 pointer-events-none"></div>
      </div>
    )}

    <!-- Body Content -->
    <div class="markdown-body space-y-12 text-on-surface relative">
      <Content />
    </div>

    <!-- Related Insights -->
    <section class="mt-32">
      <div class="flex justify-between items-end mb-12 border-b border-outline-variant pb-4">
        <h3 class="font-label-technical text-label-technical text-primary uppercase tracking-[0.3em] font-bold">
          {t('article.relatedTitle')}
        </h3>
        <a class="font-label-technical text-label-technical text-secondary hover:text-primary uppercase tracking-widest transition-colors" href={hubPath}>
          {t('article.seeAll')} &rarr;
        </a>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
        {relatedPosts.map(relatedPost => {
          const rSlug = getSlug(relatedPost.id);
          const rEnSlugKey = lang === 'es' ? reverseSlugMap[rSlug] : rSlug;
          const rMeta = articleMetadata[rEnSlugKey] || { category: lang === 'en' ? 'Insight' : 'Perspectiva' };
          const rLink = `/${lang}/${lang === 'en' ? 'insight' : 'perspectivas'}/${rSlug}`;
          
          return (
            <a class="group block space-y-4" href={rLink}>
              <div class="aspect-[1376/768] bg-surface-container overflow-hidden border border-outline-variant">
                <img 
                  alt={relatedPost.data.title} 
                  width="1376"
                  height="768"
                  class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105" 
                  src={relatedPost.data.image}
                />
              </div>
              <div>
                <p class="font-label-technical text-label-technical text-secondary uppercase mb-2">{rMeta.category}</p>
                <h4 class="font-headline-md text-headline-md text-primary group-hover:underline decoration-1 underline-offset-4 transition-all">{toPhraseCase(relatedPost.data.title)}</h4>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  @reference "../../../styles/global.css";

  .grain {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
    z-index: 9999;
    opacity: 0.03;
    background: url('https://grainy-gradients.vercel.app/noise.svg');
  }

  /* Style overrides for rendered markdown */
  .markdown-body > :global(p:first-of-type) {
    @apply font-body-lg text-body-lg leading-relaxed;
  }
  .markdown-body > :global(p:first-of-type::first-letter) {
    float: left;
    font-family: var(--font-fraunces), serif;
    font-size: 5rem;
    line-height: 1;
    padding-right: 0.75rem;
    @apply text-primary;
    font-weight: 900;
  }
  .markdown-body :global(p) {
    @apply font-body-md text-body-md mb-6 leading-relaxed opacity-90;
  }
  .markdown-body :global(h2) {
    @apply font-headline-md text-headline-md text-primary mb-6 mt-12;
  }
  .markdown-body :global(h3) {
    @apply font-headline-md text-[23.4px] text-primary mb-4 mt-8;
  }
  .markdown-body :global(ul) {
    @apply list-disc list-outside pl-6 space-y-2 mb-6 opacity-90;
  }
  .markdown-body :global(ol) {
    @apply list-decimal list-outside pl-6 space-y-2 mb-6 opacity-90;
  }
  .markdown-body :global(li) {
    @apply font-body-md text-body-md leading-relaxed;
  }
  .markdown-body :global(li p) {
    display: inline;
  }
  /* Code Blocks & Inline Code Badges */
  .markdown-body :global(.code-block-card) {
    @apply my-8 border overflow-hidden rounded-sm shadow-xl transition-all duration-300 font-mono text-sm;
  }
  .markdown-body :global(code) {
    font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace !important;
  }

  .markdown-body :global(pre),
  .markdown-body :global(pre.astro-code),
  .markdown-body :global(.code-block-card pre) {
    font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace !important;
    font-size: 13px !important;
    line-height: 1.6 !important;
    letter-spacing: -0.01em !important;
    font-weight: 400 !important;
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    overflow-x: auto !important;
  }

  /* Light Mode DevTools Code Block Theme */
  html.light .markdown-body :global(.code-block-card) {
    background-color: #ffffff !important;
    border-color: #e0e0e0 !important;
  }
  html.light .markdown-body :global(.code-titlebar) {
    background-color: #f5f5f5 !important;
    color: #1a1b1a !important;
    border-bottom-color: #e0e0e0 !important;
  }
  html.light .markdown-body :global(pre),
  html.light .markdown-body :global(pre.astro-code),
  html.light .markdown-body :global(.code-block-card pre) {
    background-color: #ffffff !important;
    color: #1a1b1a !important;
    padding: 1.25rem 1.5rem !important;
  }

  /* Dark Mode DevTools Code Block Theme */
  html:not(.light) .markdown-body :global(.code-block-card) {
    background-color: #141313 !important;
    border-color: #444748 !important;
  }
  html:not(.light) .markdown-body :global(.code-titlebar) {
    background-color: #2a2a2a !important;
    color: #e5e2e1 !important;
    border-bottom-color: #444748 !important;
  }
  html:not(.light) .markdown-body :global(pre),
  html:not(.light) .markdown-body :global(pre.astro-code),
  html:not(.light) .markdown-body :global(.code-block-card pre) {
    background-color: #141313 !important;
    color: #e5e2e1 !important;
    padding: 1.25rem 1.5rem !important;
  }
  
  /* Non-pre Inline Code Tags (e.g. inside table cells, lists, paragraphs) */
  .markdown-body :global(code:not(pre code)),
  .markdown-body :global(td code),
  .markdown-body :global(th code) {
    font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    padding: 0.15rem 0.4rem !important;
    border-radius: 2px !important;
    display: inline-block !important;
  }

  html.light .markdown-body :global(code:not(pre code)),
  html.light .markdown-body :global(td code),
  html.light .markdown-body :global(th code) {
    background-color: #ededed !important;
    color: #1a1b1a !important;
    border-color: #c0c0c0 !important;
  }

  html:not(.light) .markdown-body :global(code:not(pre code)),
  html:not(.light) .markdown-body :global(td code),
  html:not(.light) .markdown-body :global(th code) {
    background-color: #2a2a2a !important;
    color: #e5e2e1 !important;
    border-color: #444748 !important;
  }

  .markdown-body :global(strong) {
    @apply font-bold;
  }
  html.light .markdown-body :global(strong) {
    color: #1a1b1a !important;
  }
  html:not(.light) .markdown-body :global(strong) {
    color: #e5e2e1 !important;
  }

  /* Markdown Tables Styling */
  .markdown-body :global(table) {
    @apply w-full my-8 border-collapse border text-body-md overflow-hidden rounded-sm shadow-sm;
  }
  .markdown-body :global(th) {
    @apply font-bold font-fraunces p-3.5 border text-left text-sm uppercase tracking-wider;
  }
  .markdown-body :global(td) {
    @apply p-3.5 border text-sm leading-relaxed;
  }

  /* Light Mode Table Theme */
  html.light .markdown-body :global(table) {
    background-color: #ffffff !important;
    color: #1a1b1a !important;
    border-color: #e0e0e0 !important;
  }
  html.light .markdown-body :global(th) {
    background-color: #f5f5f5 !important;
    color: #1a1b1a !important;
    border-color: #e0e0e0 !important;
  }
  html.light .markdown-body :global(td) {
    background-color: #ffffff !important;
    color: #1a1b1a !important;
    border-color: #e0e0e0 !important;
  }
  html.light .markdown-body :global(tr:nth-child(even) td) {
    background-color: #f9f9f9 !important;
  }
  html.light .markdown-body :global(tr:hover td) {
    background-color: #f0f0f0 !important;
  }

  /* Dark Mode Table Theme */
  html:not(.light) .markdown-body :global(table) {
    background-color: #141313 !important;
    color: #e5e2e1 !important;
    border-color: #444748 !important;
  }
  html:not(.light) .markdown-body :global(th) {
    background-color: #2a2a2a !important;
    color: #ffffff !important;
    border-color: #444748 !important;
  }
  html:not(.light) .markdown-body :global(td) {
    background-color: #141313 !important;
    color: #e5e2e1 !important;
    border-color: #444748 !important;
  }
  html:not(.light) .markdown-body :global(tr:nth-child(even) td) {
    background-color: #1c1b1b !important;
  }
  html:not(.light) .markdown-body :global(tr:hover td) {
    background-color: #252424 !important;
  }
  /* DevTools Token Syntax Colors */
  html.light .markdown-body :global(.devtools-token-tag) { color: #001199 !important; font-weight: 600; }
  html.light .markdown-body :global(.devtools-token-attr) { color: #990000 !important; }
  html.light .markdown-body :global(.devtools-token-string) { color: #116600 !important; }
  html.light .markdown-body :global(.devtools-token-bracket) { color: #666666 !important; }
  html.light .markdown-body :global(.devtools-token-comment) { color: #556677 !important; font-style: italic; }
  html.light .markdown-body :global(.devtools-token-plain) { color: #1a1b1a !important; }

  html:not(.light) .markdown-body :global(.devtools-token-tag) { color: #5DB0D7 !important; font-weight: 600; }
  html:not(.light) .markdown-body :global(.devtools-token-attr) { color: #9CDCFE !important; }
  html:not(.light) .markdown-body :global(.devtools-token-string) { color: #F29766 !important; }
  html:not(.light) .markdown-body :global(.devtools-token-bracket) { color: #808080 !important; }
  html:not(.light) .markdown-body :global(.devtools-token-comment) { color: #6A9955 !important; font-style: italic; }
  html:not(.light) .markdown-body :global(.devtools-token-plain) { color: #e5e2e1 !important; }
</style>

<script>
  // Simple scroll reveal interaction
  const observerOptions = {
    threshold: 0.1
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('opacity-100', 'translate-y-0');
        entry.target.classList.remove('opacity-0', 'translate-y-10');
      }
    });
  }, observerOptions);

  document.querySelectorAll('section, figure, blockquote').forEach(el => {
    el.classList.add('transition-all', 'duration-1000', 'opacity-0', 'translate-y-10');
    observer.observe(el);
  });
</script>

<script>
  import "../../../scripts/html-playground.ts";

  // Decorate standard markdown code blocks with Chrome DevTools window titlebar across all articles
  const decorateDevToolsCodeBlocks = () => {
    document.querySelectorAll('.markdown-body pre').forEach((pre) => {
      if (pre.closest('html-playground')) return;
      
      // Strip Shiki inline background and color attributes
      pre.removeAttribute('style');

      if (!pre.closest('.code-block-card')) {
        const langAttr = pre.getAttribute('data-language') || 'html';
        const filename = langAttr.toUpperCase();

        const wrapper = document.createElement('div');
        wrapper.className = 'code-block-card border border-outline-variant bg-surface-container-lowest overflow-hidden my-8 shadow-xl rounded-sm font-mono text-sm transition-all duration-300';
        
        const titlebar = document.createElement('div');
        titlebar.className = 'code-titlebar bg-surface-container-high px-4 py-2 border-b border-outline-variant flex items-center justify-between flex-wrap gap-2 text-on-surface shrink-0';
        titlebar.innerHTML = `
          <div class="flex items-center space-x-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
            <span class="text-xs text-on-surface-variant font-mono ml-2">${filename}</span>
          </div>
        `;

        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(titlebar);
        wrapper.appendChild(pre);
      }

      // Strip Shiki inline token colors and apply Chrome DevTools syntax highlighting classes
      pre.querySelectorAll('span').forEach((span) => {
        if (span.classList.contains('line') && span.children.length > 0) return;

        span.removeAttribute('style');
        const text = span.textContent || '';
        const trimmed = text.trim();

        if (/^<\/?!?[a-zA-Z0-9]+>?$/i.test(trimmed) || /^(html|head|title|meta|style|script|link|body|h1|h2|h3|h4|h5|h6|p|ul|ol|li|table|tr|td|th|img|video|audio|div|span|a|button|DOCTYPE|doctype)$/i.test(trimmed)) {
          span.classList.add('devtools-token-tag');
        } else if (/^[a-zA-Z0-9_-]+=$/i.test(trimmed) || /^(name|content|class|src|href|alt|title|type|rel|id|lang|charset|style)$/i.test(trimmed)) {
          span.classList.add('devtools-token-attr');
        } else if (/^"[^"]*"$|^'[^']*'$/i.test(trimmed)) {
          span.classList.add('devtools-token-string');
        } else if (/^[<>\/={};:]+$/.test(trimmed)) {
          span.classList.add('devtools-token-bracket');
        } else if (trimmed.startsWith('/*') || trimmed.startsWith('//') || trimmed.startsWith('<!--')) {
          span.classList.add('devtools-token-comment');
        } else {
          span.classList.add('devtools-token-plain');
        }
      });
    });
  };

  decorateDevToolsCodeBlocks();
  document.addEventListener('DOMContentLoaded', decorateDevToolsCodeBlocks);
</script>
