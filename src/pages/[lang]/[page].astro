---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { useTranslations, reverseSlugMap } from '../../utils/i18n';
import { extractBehanceProjectId } from '../../utils/behance';

function toPhraseCase(str: string) {
    if (!str) return '';
    const lower = str.toLowerCase();
    const match = lower.match(/[a-zñáéíóúü]/i);
    if (match) {
        return lower.substring(0, match.index) + lower.charAt(match.index).toUpperCase() + lower.substring(match.index + 1);
    }
    return lower;
}

export async function getStaticPaths() {
  return [
    { params: { lang: 'en', page: 'works' } },
    { params: { lang: 'es', page: 'trabajos' } },
    { params: { lang: 'en', page: 'insight' } },
    { params: { lang: 'es', page: 'perspectivas' } },
  ];
}

const { lang, page } = Astro.params;
const t = useTranslations(lang);

const isWorksPage = page === 'works' || page === 'trabajos';
const isInsightPage = page === 'insight' || page === 'perspectivas';

// Determine link helpers based on lang
const ctaWorksLink = lang === 'en' ? '/en/works' : '/es/trabajos';

// ----------------------------------------
// INSIGHT HUB LOGIC
// ----------------------------------------
const allPosts = isInsightPage 
  ? await getCollection('blog', ({ data }) => data.language === lang) 
  : [];

// ----------------------------------------
// WORKS HUB LOGIC
// ----------------------------------------
const allWorks = isWorksPage ? await getCollection('works') : [];

const worksAlpha = allWorks
  .filter((w) => w.data.cluster === 'alpha')
  .sort((a, b) => a.data.order - b.data.order);

const worksBeta = allWorks
  .filter((w) => w.data.cluster === 'beta')
  .sort((a, b) => a.data.order - b.data.order);

const worksGamma = allWorks
  .filter((w) => w.data.cluster === 'gamma')
  .sort((a, b) => a.data.order - b.data.order);

function getBetaCardClass(index: number, totalCards: number) {
  const isEven = totalCards % 2 === 0;
  const isFullWidth = isEven && index === 0;

  const baseClasses = "bg-surface border border-outline-variant p-6 flex flex-col justify-between hover:border-primary focus-within:border-primary focus:outline-none transition-all duration-300 group relative overflow-hidden";

  if (isFullWidth) {
    return `col-span-4 md:col-span-12 min-h-[200px] ${baseClasses}`;
  }
  
  if (!isFullWidth && index < (isEven ? 3 : 2)) {
    return `col-span-4 md:col-span-6 min-h-[300px] ${baseClasses}`;
  }

  return `col-span-4 md:col-span-6 min-h-[150px] ${baseClasses}`;
}

const getSlug = (id: string) => id.split('/').pop()?.replace(/\.md$/, '') || '';

// Sort orders
const ceoOrder = lang === 'en' 
  ? [
      'everything-is-design-the-philosophy-of-utility',
      'the-logo-and-the-company-the-investment-in-trust',
      'the-value-of-graphic-design-a-strategic-perspective',
      'graphic-design-and-branding-the-authority-system'
    ]
  : [
      'todo-es-diseno-la-filosofia-de-la-utilidad',
      'el-logotipo-y-la-empresa-la-inversion-en-confianza',
      'el-valor-del-diseno-grafico',
      'diseno-grafico-y-branding-el-sistema-de-autoridad'
    ];

const visualOrder = lang === 'en'
  ? [
      'what-is-typography-the-dna-of-information',
      'typographic-classification-the-geometry-of-tone',
      'the-logo-variants-strategic-adaptability',
      'visual-communication-or-graphic-design',
      'illustrator-basics-precision-tools'
    ]
  : [
      'que-es-la-tipografia-el-adn-de-la-civilizacion',
      'clasificacion-tipografica-la-geometria-del-tono',
      'las-variantes-del-logotipo-adaptabilidad-estrategica',
      'comunicacion-visual-o-diseno-grafico',
      'illustrator-basico-herramientas-de-precision'
    ];

const builderOrder = lang === 'en'
  ? [
      'what-is-the-utility-of-learning-html',
      'what-is-html-the-structure-of-information',
      'what-is-css-the-visual-style-system',
      'the-translation-gap-in-digital-products'
    ]
  : [
      'cual-es-la-utilidad-de-aprender-html',
      'que-es-html-la-estructura-de-la-informacion',
      'que-es-css-el-sistema-de-estilo-visual',
      'el-desfase-en-la-alineacion-en-productos-digitales'
    ];

const ceoPosts = isInsightPage
  ? allPosts
      .filter(p => p.data.lens === 'ceo_lens')
      .sort((a, b) => ceoOrder.indexOf(getSlug(a.id)) - ceoOrder.indexOf(getSlug(b.id)))
  : [];

const visualPosts = isInsightPage
  ? allPosts
      .filter(p => p.data.lens === 'visual_lens')
      .sort((a, b) => visualOrder.indexOf(getSlug(a.id)) - visualOrder.indexOf(getSlug(b.id)))
  : [];

const builderPosts = isInsightPage
  ? allPosts
      .filter(p => p.data.lens === 'builder_lens')
      .sort((a, b) => builderOrder.indexOf(getSlug(a.id)) - builderOrder.indexOf(getSlug(b.id)))
  : [];

// Card aesthetic config getter
const getCardConfig = (postSlug: string) => {
  const configs: Record<string, any> = {
    // Lens 01
    'everything-is-design-the-philosophy-of-utility': {
      type: 'large-bg-split',
      tag: lang === 'en' ? 'Business Strategy' : 'Estrategia de Negocios',
    },
    'the-logo-and-the-company-the-investment-in-trust': {
      type: 'stat-small',
      label: '01.02 — ROI',
      pills: lang === 'en' ? ['Identity', 'Capital'] : ['Identidad', 'Capital'],
    },
    'the-value-of-graphic-design-a-strategic-perspective': {
      type: 'stat-small',
      label: lang === 'en' ? '01.03 — IMPACT' : '01.03 — IMPACTO',
      pills: lang === 'en' ? ['Analytics'] : ['Métricas'],
    },
    'graphic-design-and-branding-the-authority-system': {
      type: 'stat-small',
      label: lang === 'en' ? '01.04 — AUTHORITY' : '01.04 — AUTORIDAD',
      pills: lang === 'en' ? ['Brand', 'Strategy'] : ['Marca', 'Estrategia'],
    },
    // Lens 02
    'what-is-typography-the-dna-of-information': {
      type: 'overlay-bg',
    },
    'typographic-classification-the-geometry-of-tone': {
      type: 'taxonomy-card',
      description: lang === 'en' 
        ? 'A technical taxonomy of letterforms from Humanist to Geometric Sans.' 
        : 'Una taxonomía técnica de las formas de las letras desde las Humanistas hasta las Sans Geométricas.',
      refLabel: lang === 'en' ? 'Reference 02.02' : 'Referencia 02.02',
    },
    'the-logo-variants-strategic-adaptability': {
      type: 'icon-card',
      icon: 'pentagon',
      label: '02.04',
    },
    'visual-communication-or-graphic-design': {
      type: 'hover-translate',
      description: lang === 'en' 
        ? 'Defining functional message transmission.' 
        : 'Definiendo la transmisión funcional de mensajes.',
    },
    'illustrator-basics-precision-tools': {
      type: 'banner-wide-split',
      description: lang === 'en' 
        ? 'Mastering precision vector systems, anchor point logic, and geometric craft.' 
        : 'Dominando los sistemas vectoriales de precisión, la lógica de los puntos de anclaje y el oficio geométrico.',
    },
    // Lens 03
    'what-is-the-utility-of-learning-html': {
      type: 'action-card',
      description: lang === 'en' 
        ? 'Why every visual designer must understand the substrate of their work to achieve technical excellence.' 
        : 'Por qué todo diseñador visual debe comprender el sustrato de su trabajo para lograr la excelencia técnica.',
      btnText: lang === 'en' ? 'Read Whitepaper' : 'Leer Documento',
      icon: 'code',
    },
    'what-is-html-the-structure-of-information': {
      type: 'code-snippet',
      code: '<section id="html">',
      description: lang === 'en' 
        ? 'The semantic skeleton of the digital universe.' 
        : 'El esqueleto semántico del universo digital.',
      bottomLabel: lang === 'en' ? 'Documentation / Structure' : 'Documentación / Estructura',
    },
    'what-is-css-the-visual-style-system': {
      type: 'code-snippet',
      code: '.design { display: flex; }',
      description: lang === 'en' 
        ? 'The logic of visual presentation and spatial rhythm.' 
        : 'La lógica de la presentación visual y el ritmo espacial.',
      bottomLabel: lang === 'en' ? 'Documentation / Presentation' : 'Documentación / Presentación',
    },
    'the-translation-gap-in-digital-products': {
      type: 'banner-right-image',
      description: lang === 'en' 
        ? 'Explore the methodology of code-driven design. Where aesthetics meet algorithmic precision.' 
        : 'Explore la metodología del diseño orientado por código. Donde la estética se encuentra con la precisión algorítmica.',
    },
  };

  const enSlug = lang === 'es' ? reverseSlugMap[postSlug] : postSlug;
  return configs[enSlug] || {};
};

const pagePathPrefix = lang === 'en' ? '/en/insight/' : '/es/perspectivas/';
