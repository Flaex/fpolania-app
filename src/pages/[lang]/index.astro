---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../utils/i18n';
import { extractBehanceProjectId } from '../../utils/behance';

function toPhraseCase(str: string) {
    if (!str) return '';
    const lower = str.toLowerCase();
    const match = lower.match(/[a-zñáéíóúü]/i);
    if (match) {
        return lower.substring(0, match.index) + lower.charAt(match.index).toUpperCase() + lower.substring(match.index + 1);
    }
    return lower;
}

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);

// Get the blog posts matching the active language
const posts = await getCollection('blog', ({ data }) => data.language === lang);

// Get the featured works
const featuredWorks = await getCollection('works', ({ data }) => data.featured);
featuredWorks.sort((a, b) => (a.data.featuredOrder || 0) - (b.data.featuredOrder || 0));

// Find the primary strategic translation article or default to first
const targetIdPart = lang === 'en' 
  ? 'the-translation-gap-in-digital-products' 
  : 'el-desfase-en-la-alineacion-en-productos-digitales';

const latestPost = posts.find(p => p.id.includes(targetIdPart)) || posts[0];
const slug = latestPost ? latestPost.id.split('/').pop().replace(/\.md$/, '') : '';
const latestPostSummary = latestPost ? t(`summaries.${slug}`) : '';

// Localized links
const explorePath = lang === 'en' ? '/en/insight' : '/es/perspectivas';
const articlePath = lang === 'en' ? `/en/insight/${slug}` : `/es/perspectivas/${slug}`;
const worksPath = lang === 'en' ? '/en/works' : '/es/trabajos';
---

<Layout title={t('home.metaTitle')} description={t('home.metaDescription')} lang={lang}>
    <Navigation />
    
    <main class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop pt-6 pb-6 md:pb-12 md:pt-6 space-y-24">
        <!-- ZONE 1: THE STRATEGIC CORE -->
        <section>
            <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-12 gap-gutter auto-rows-[minmax(180px,auto)]">
                <!-- Hero (4x2 equivalent in a 12 col grid, spans 8 cols, 2 rows) -->
                <div class="bento-card col-span-1 md:col-span-4 lg:col-span-8 lg:row-span-2 p-8 md:p-12 flex flex-col justify-between rounded-lg">
                    <div>
                        <p class="font-label-technical text-label-technical text-on-surface-variant mb-4 uppercase tracking-widest">{t('home.executiveSummary')}</p>
                        <h1 class="font-display text-display mb-6 text-primary font-black">{t('home.role')}</h1>
                        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mb-8">
                            {t('home.roleSubtitle')}
                        </p>
                    </div>
                    <div class="mt-auto">
                        <a class="inline-flex items-center justify-center bg-primary text-on-primary font-body-md text-body-md font-bold px-6 py-3 rounded-lg hover:opacity-85 transition-all animate-fade-in" href={explorePath}>
                            {t('home.exploreCommand')} <span class="material-symbols-outlined ml-2 text-lg">arrow_forward</span>
                        </a>
                    </div>
                </div>

                <!-- Latest Insight (2x2) -->
                {latestPost && (
                    <div class="bento-card col-span-1 md:col-span-2 lg:col-span-4 lg:row-span-2 p-8 flex flex-col justify-between rounded-lg group hover:border-silver transition-colors">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="font-label-technical text-label-technical text-on-surface-variant uppercase">{t('home.latestInsight')}</span>
                                <span class="material-symbols-outlined text-dim-grey group-hover:text-primary transition-colors">north_east</span>
                            </div>
                            <h2 class="font-headline-md text-headline-md mb-4 text-primary font-bold">{toPhraseCase(latestPost.data.title)}</h2>
                            <p class="font-body-md text-body-md text-on-surface-variant line-clamp-4">
                                {latestPostSummary}
                            </p>
                        </div>
                        <div class="mt-8">
                            <a class="text-primary border-b border-primary pb-1 inline-flex items-center font-medium hover:text-silver transition-colors" href={articlePath}>
                                {t('home.readArticle')} <span class="material-symbols-outlined ml-1 text-sm">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                )}

                <!-- Strategic Cards Row -->
                <!-- Case Studies Portal (1x1 equivalent) -->
                <div class="bento-card col-span-1 md:col-span-1 lg:col-span-3 p-8 flex flex-col justify-between rounded-lg group hover:border-silver transition-colors">
                    <div>
                        <h3 class="font-headline-md text-headline-md mb-3 text-primary font-bold">{t('home.worksCardTitle')}</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                            {t('home.worksCardDesc')}
                        </p>
                    </div>
                    <div class="mt-6">
                        <a class="text-primary border-b border-primary pb-1 inline-flex items-center font-medium hover:text-silver transition-colors" href={worksPath}>
                            {t('home.worksCardCta')} <span class="material-symbols-outlined ml-1 text-sm">arrow_forward</span>
                        </a>
                    </div>
                </div>

                <!-- Card 1 (2x1 equivalent) -->
                <div class="bento-card col-span-1 md:col-span-3 lg:col-span-5 p-8 flex flex-col justify-center rounded-lg">
                    <h3 class="font-headline-md text-headline-md mb-3 text-primary font-bold">{t('home.messyMiddleTitle')}</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant">
                        {t('home.messyMiddleDesc')}
                    </p>
                </div>

                <!-- Card 2 (2x1 equivalent) -->
                <div class="bento-card col-span-1 md:col-span-4 lg:col-span-4 p-8 flex flex-col justify-center rounded-lg">
                    <h3 class="font-headline-md text-headline-md mb-3 text-primary font-bold">{t('home.aiTitle')}</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant">
                        {t('home.aiDesc')}
                    </p>
                </div>
            </div>
        </section>

        <!-- ZONE 2: FEATURED WORKS -->
        <section>
            <div class="flex items-center justify-between mb-8 border-b border-outline-variant pb-4">
                <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary font-black animate-fade-in">{t('home.featuredWorks')}</h2>
                <a class="font-body-md text-on-surface-variant hover:text-primary transition-colors flex items-center font-medium" href={worksPath}>
                    {t('home.viewAll')} <span class="material-symbols-outlined ml-1">arrow_forward</span>
                </a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-12 gap-gutter auto-rows-[minmax(240px,auto)]">
                {featuredWorks.map((project) => {
                    const title = lang === 'en' ? project.data.titleEn : project.data.titleEs;
                    const desc = lang === 'en' ? project.data.descriptionEn : project.data.descriptionEs;
                    const behanceUrl = project.data.behanceUrl;
                    const spanClass = `bento-card ${project.data.featuredSpan || "col-span-1 md:col-span-2 lg:col-span-6 p-6 flex flex-col justify-end rounded-lg group relative overflow-hidden h-[240px]"}`;
                    const projectId = extractBehanceProjectId(behanceUrl);
                    
                    const LinkTag = 'div';
                    const linkProps = {
                        class: `${spanClass} focus:outline-none`,
                        tabindex: 0,
                    };

                    return (
                        <LinkTag {...linkProps}>
                            {project.data.image ? (
                                <div class="absolute inset-0 z-0">
                                    <img 
                                        src={project.data.image} 
                                        alt={title} 
                                        class="w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-focus-within:grayscale-0 group-hover:scale-105 group-focus-within:scale-105 transition-all duration-700" 
                                    />
                                </div>
                            ) : (
                                <div class="absolute inset-0 bg-surface-container-highest opacity-50 transition-opacity group-hover:opacity-30 z-0"></div>
                            )}
                            <div class="relative z-10 p-4 border border-outline-variant bg-surface/90 backdrop-blur-sm rounded w-full">
                                <h3 class="font-headline-md text-headline-md mb-1 text-lg text-primary font-bold">{title}</h3>
                                <p class="font-body-md text-body-md text-on-surface-variant text-sm">{desc}</p>
                            </div>
                            {behanceUrl && (
                                <div class="absolute inset-0 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300 z-20 flex items-center justify-center pointer-events-none backdrop-blur-md bg-black/40">
                                    <a href={behanceUrl} target="_blank" rel="noopener noreferrer" class="pointer-events-auto bg-primary text-on-primary text-center py-2.5 px-3 md:py-3 md:px-6 flex items-center justify-center gap-1.5 md:gap-[10px] text-[0.8rem] md:text-[.95rem] tracking-tight hover:bg-on-primary hover:text-primary transition-all duration-300">
                                        <span class="leading-none mt-[1px]">View on Behance</span>
                                        <svg viewBox="0 0 24 24" fill="currentColor" class="w-[1rem] h-[1rem] md:w-[1.2rem] md:h-[1.2rem]"><path d="M16.969 16.927a2.561 2.561 0 0 0 1.901.677 2.501 2.501 0 0 0 1.531-.475c.362-.235.636-.584.779-.99h2.585a5.091 5.091 0 0 1-1.9 2.896 5.292 5.292 0 0 1-3.091.88 5.839 5.839 0 0 1-2.284-.433 4.871 4.871 0 0 1-1.723-1.211 5.657 5.657 0 0 1-1.08-1.874 7.057 7.057 0 0 1-.383-2.393c-.005-.8.129-1.595.396-2.349a5.313 5.313 0 0 1 5.088-3.604 4.87 4.87 0 0 1 2.376.563c.661.362 1.231.87 1.668 1.485a6.2 6.2 0 0 1 .943 2.133c.194.821.263 1.666.205 2.508h-7.699c-.063.79.184 1.574.688 2.187ZM6.947 4.084a8.065 8.065 0 0 1 1.928.198 4.29 4.29 0 0 1 1.49.638c.418.303.748.711.958 1.182.241.579.357 1.203.341 1.83a3.506 3.506 0 0 1-.506 1.961 3.726 3.726 0 0 1-1.503 1.287 3.588 3.588 0 0 1 2.027 1.437c.464.747.697 1.615.67 2.494a4.593 4.593 0 0 1-.423 2.032 3.945 3.945 0 0 1-1.163 1.413 5.114 5.114 0 0 1-1.683.807 7.135 7.135 0 0 1-1.928.259H0V4.084h6.947Zm-.235 12.9c.308.004.616-.029.916-.099a2.18 2.18 0 0 0 .766-.332c.228-.158.411-.371.534-.619.142-.317.208-.663.191-1.009a2.08 2.08 0 0 0-.642-1.715 2.618 2.618 0 0 0-1.696-.505h-3.54v4.279h3.471Zm13.635-5.967a2.13 2.13 0 0 0-1.654-.619 2.336 2.336 0 0 0-1.163.259 2.474 2.474 0 0 0-.738.62 2.359 2.359 0 0 0-.396.792c-.074.239-.12.485-.137.734h4.769a3.239 3.239 0 0 0-.679-1.785l-.002-.001Zm-13.813-.648a2.254 2.254 0 0 0 1.423-.433c.399-.355.607-.88.56-1.413a1.916 1.916 0 0 0-.178-.891 1.298 1.298 0 0 0-.495-.533 1.851 1.851 0 0 0-.711-.274 3.966 3.966 0 0 0-.835-.073H3.241v3.631h3.293v-.014ZM21.62 5.122h-5.976v1.527h5.976V5.122Z"/></svg>
                                    </a>
                                </div>
                            )}
                        </LinkTag>
                    );
                })}
            </div>
        </section>

        <!-- ZONE 4: THE ACTION CLUSTER -->
        <section class="border-t border-outline-variant pt-12">
            <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-12 gap-gutter">
                <!-- Audit CTA (3x1 equivalent) -->
                <div class="bento-card col-span-1 md:col-span-4 lg:col-span-8 p-12 flex flex-col md:flex-row items-start md:items-center justify-between rounded-lg bg-surface-container-high border-silver">
                    <div class="mb-6 md:mb-0 md:mr-8 max-w-lg">
                        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-4 text-primary font-black">{t('home.ctaTitle')}</h2>
                        <p class="font-body-lg text-body-lg text-on-surface-variant">{t('home.ctaDesc')}</p>
                    </div>
                    <a class="whitespace-nowrap inline-flex items-center justify-center bg-primary text-on-primary font-body-md text-body-md font-bold px-8 py-4 rounded-lg hover:opacity-85 transition-all" href={`mailto:fpolania@gmail.com?subject=${encodeURIComponent(t('home.ctaSubject'))}`}>
                        {t('home.ctaButton')}
                    </a>
                </div>
                
                <!-- Social Cluster -->
                <div class="col-span-1 md:col-span-4 lg:col-span-4 flex items-center justify-center gap-6">
                    <a class="w-10 h-10 flex items-center justify-center border border-outline-variant rounded-full text-on-surface-variant hover:text-primary hover:border-primary transition-all duration-200" href="https://www.linkedin.com/in/freddypolania/" title="LinkedIn" target="_blank" rel="noopener noreferrer">
                        <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
                        </svg>
                    </a>
                    <a class="w-10 h-10 flex items-center justify-center border border-outline-variant rounded-full text-on-surface-variant hover:text-primary hover:border-primary transition-all duration-200" href="https://www.behance.net/fredypolania" title="Behance" target="_blank" rel="noopener noreferrer">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M16.969 16.927a2.561 2.561 0 0 0 1.901.677 2.501 2.501 0 0 0 1.531-.475c.362-.235.636-.584.779-.99h2.585a5.091 5.091 0 0 1-1.9 2.896 5.292 5.292 0 0 1-3.091.88 5.839 5.839 0 0 1-2.284-.433 4.871 4.871 0 0 1-1.723-1.211 5.657 5.657 0 0 1-1.08-1.874 7.057 7.057 0 0 1-.383-2.393c-.005-.8.129-1.595.396-2.349a5.313 5.313 0 0 1 5.088-3.604 4.87 4.87 0 0 1 2.376.563c.661.362 1.231.87 1.668 1.485a6.2 6.2 0 0 1 .943 2.133c.194.821.263 1.666.205 2.508h-7.699c-.063.79.184 1.574.688 2.187ZM6.947 4.084a8.065 8.065 0 0 1 1.928.198 4.29 4.29 0 0 1 1.49.638c.418.303.748.711.958 1.182.241.579.357 1.203.341 1.83a3.506 3.506 0 0 1-.506 1.961 3.726 3.726 0 0 1-1.503 1.287 3.588 3.588 0 0 1 2.027 1.437c.464.747.697 1.615.67 2.494a4.593 4.593 0 0 1-.423 2.032 3.945 3.945 0 0 1-1.163 1.413 5.114 5.114 0 0 1-1.683.807 7.135 7.135 0 0 1-1.928.259H0V4.084h6.947Zm-.235 12.9c.308.004.616-.029.916-.099a2.18 2.18 0 0 0 .766-.332c.228-.158.411-.371.534-.619.142-.317.208-.663.191-1.009a2.08 2.08 0 0 0-.642-1.715 2.618 2.618 0 0 0-1.696-.505h-3.54v4.279h3.471Zm13.635-5.967a2.13 2.13 0 0 0-1.654-.619 2.336 2.336 0 0 0-1.163.259 2.474 2.474 0 0 0-.738.62 2.359 2.359 0 0 0-.396.792c-.074.239-.12.485-.137.734h4.769a3.239 3.239 0 0 0-.679-1.785l-.002-.001Zm-13.813-.648a2.254 2.254 0 0 0 1.423-.433c.399-.355.607-.88.56-1.413a1.916 1.916 0 0 0-.178-.891 1.298 1.298 0 0 0-.495-.533 1.851 1.851 0 0 0-.711-.274 3.966 3.966 0 0 0-.835-.073H3.241v3.631h3.293v-.014ZM21.62 5.122h-5.976v1.527h5.976V5.122Z"></path>
                        </svg>
                    </a>
                    <a class="w-10 h-10 flex items-center justify-center border border-outline-variant rounded-full text-on-surface-variant hover:text-primary hover:border-primary transition-all duration-200" href="https://github.com/Flaex" title="GitHub" target="_blank" rel="noopener noreferrer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                        </svg>
                    </a>
                    <a class="w-10 h-10 flex items-center justify-center border border-outline-variant rounded-full text-on-surface-variant hover:text-primary hover:border-primary transition-all duration-200" href="https://x.com/Flaex_" title="X" target="_blank" rel="noopener noreferrer">
                        <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932 6.064-6.932zm-1.292 19.49h2.039L6.486 3.24H4.298l13.311 17.403z"></path>
                        </svg>
                    </a>
                    <a class="w-10 h-10 flex items-center justify-center border border-outline-variant rounded-full text-on-surface-variant hover:text-primary hover:border-primary transition-all duration-200" href="https://www.instagram.com/fpolania_/" title="Instagram" target="_blank" rel="noopener noreferrer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
                            <rect height="20" rx="5" ry="5" width="20" x="2" y="2"></rect>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    </main>
    
    <Footer />
</Layout>
