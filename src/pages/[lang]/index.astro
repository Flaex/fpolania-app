---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../utils/i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang);

// Get the blog posts matching the active language
const posts = await getCollection('blog', ({ data }) => data.language === lang);

// Find the primary strategic translation article or default to first
const targetIdPart = lang === 'en' 
  ? 'graphic-design-and-web-programming-the-strategic-translation' 
  : 'diseno-grafico-y-programacion-web-la-traduccion-estrategica';

const latestPost = posts.find(p => p.id.includes(targetIdPart)) || posts[0];
const slug = latestPost ? latestPost.id.split('/').pop().replace(/\.md$/, '') : '';
const latestPostSummary = latestPost ? t(`summaries.${slug}`) : '';

// Localized links
const explorePath = lang === 'en' ? '/en/insight' : '/es/perspectivas';
const articlePath = lang === 'en' ? `/en/insight/${slug}` : `/es/perspectivas/${slug}`;
const worksPath = lang === 'en' ? '/en/works' : '/es/trabajos';
---

<Layout title={t('home.metaTitle')} description={t('home.metaDescription')} lang={lang}>
    <Navigation />
    
    <main class="flex-grow w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 md:py-24 space-y-24">
        <!-- ZONE 1: THE STRATEGIC CORE -->
        <section>
            <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-12 gap-gutter auto-rows-[minmax(180px,auto)]">
                <!-- Hero (4x2 equivalent in a 12 col grid, spans 8 cols, 2 rows) -->
                <div class="bento-card col-span-1 md:col-span-4 lg:col-span-8 lg:row-span-2 p-8 md:p-12 flex flex-col justify-between rounded-lg">
                    <div>
                        <p class="font-label-technical text-label-technical text-dim-grey mb-4 uppercase tracking-widest">{t('home.executiveSummary')}</p>
                        <h1 class="font-display text-display mb-6 text-white font-black">{t('home.role')}</h1>
                        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mb-8">
                            {t('home.roleSubtitle')}
                        </p>
                    </div>
                    <div class="mt-auto">
                        <a class="inline-flex items-center justify-center bg-primary text-carbon font-body-md text-body-md font-bold px-6 py-3 rounded-lg hover:bg-silver transition-colors animate-fade-in" href={explorePath}>
                            {t('home.exploreCommand')} <span class="material-symbols-outlined ml-2 text-lg">arrow_forward</span>
                        </a>
                    </div>
                </div>

                <!-- Latest Insight (2x2) -->
                {latestPost && (
                    <div class="bento-card col-span-1 md:col-span-2 lg:col-span-4 lg:row-span-2 p-8 flex flex-col justify-between rounded-lg group hover:border-silver transition-colors">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="font-label-technical text-label-technical text-dim-grey uppercase">{t('home.latestInsight')}</span>
                                <span class="material-symbols-outlined text-dim-grey group-hover:text-primary transition-colors">north_east</span>
                            </div>
                            <h2 class="font-headline-md text-headline-md mb-4 text-white font-bold">{latestPost.data.title}</h2>
                            <p class="font-body-md text-body-md text-on-surface-variant line-clamp-4">
                                {latestPostSummary}
                            </p>
                        </div>
                        <div class="mt-8">
                            <a class="text-primary border-b border-primary pb-1 inline-flex items-center font-medium hover:text-silver transition-colors" href={articlePath}>
                                {t('home.readArticle')} <span class="material-symbols-outlined ml-1 text-sm">arrow_forward</span>
                            </a>
                        </div>
                    </div>
                )}

                <!-- Strategic Cards Row -->
                <!-- Authority Stat (1x1 equivalent) -->
                <div class="bento-card col-span-1 md:col-span-1 lg:col-span-3 p-8 flex flex-col justify-center items-center text-center rounded-lg">
                    <h3 class="font-display text-display text-primary mb-2 font-black">15+</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant">{t('home.yearsLeadership')}</p>
                </div>

                <!-- Card 1 (2x1 equivalent) -->
                <div class="bento-card col-span-1 md:col-span-3 lg:col-span-5 p-8 flex flex-col justify-center rounded-lg">
                    <h3 class="font-headline-md text-headline-md mb-3 text-white font-bold">{t('home.messyMiddleTitle')}</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant">
                        {t('home.messyMiddleDesc')}
                    </p>
                </div>

                <!-- Card 2 (2x1 equivalent) -->
                <div class="bento-card col-span-1 md:col-span-4 lg:col-span-4 p-8 flex flex-col justify-center rounded-lg">
                    <h3 class="font-headline-md text-headline-md mb-3 text-white font-bold">{t('home.aiTitle')}</h3>
                    <p class="font-body-md text-body-md text-on-surface-variant">
                        {t('home.aiDesc')}
                    </p>
                </div>
            </div>
        </section>

        <!-- ZONE 2: FEATURED WORKS -->
        <section>
            <div class="flex items-center justify-between mb-8 border-b border-dim-grey pb-4">
                <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-white font-black animate-fade-in">{t('home.featuredWorks')}</h2>
                <a class="font-body-md text-dim-grey hover:text-primary transition-colors flex items-center font-medium" href={worksPath}>
                    {t('home.viewAll')} <span class="material-symbols-outlined ml-1">arrow_forward</span>
                </a>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-12 gap-gutter auto-rows-[minmax(240px,auto)]">
                <!-- Project 1 (3x2) -->
                <a class="bento-card col-span-1 md:col-span-4 lg:col-span-6 lg:row-span-2 p-6 flex flex-col justify-end rounded-lg group relative overflow-hidden h-[400px] lg:h-auto" href="https://www.behance.net/gallery/28402277/Banco-del-Libro-web-design-anddevelopment" target="_blank" rel="noopener noreferrer">
                    <div class="absolute inset-0 z-0">
                        <img 
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBt3gEJY9r3hNhyV7Ms2ePpSGcVd2e1A-eD0nt3n8EWGYOqiw-zMHz43OtmUh9PPb7pqRIf6aHATny4LqnhoGmBh9na7iQVZJQf3O4F7Swga5tJ8sqOKVLcsNgo9bhx-w5SxWjSPxCnwsvTRJVM6Z9xo2tS8IXtmThTcKTuE7DK1r3iWrefpGj75tly-Kz_b7CnbZwRpk3ZVWRqtoFX9OVHxfl8uBsKkhEZKSExcu-I-xcNELV5UlQLjLuk6wELbSxNwhzy98MtgzqE" 
                            alt="Banco del Libro" 
                            class="w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700" 
                        />
                    </div>
                    <div class="relative z-10 p-4 border border-dim-grey bg-carbon/90 backdrop-blur-sm rounded">
                        <h3 class="font-headline-md text-headline-md mb-2 text-white font-bold">Banco del Libro</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant">{t('home.bancoLibroSub')}</p>
                    </div>
                </a>
                
                <!-- Project 2 (2x1) -->
                <a class="bento-card col-span-1 md:col-span-2 lg:col-span-6 p-6 flex flex-col justify-end rounded-lg group relative overflow-hidden h-[240px]" href="https://www.behance.net/gallery/201803207/Maximiza-Branding-y-diseno-web" target="_blank" rel="noopener noreferrer">
                    <div class="absolute inset-0 bg-surface-container-highest opacity-50 transition-opacity group-hover:opacity-30 z-0"></div>
                    <div class="relative z-10 p-4 border border-dim-grey bg-carbon/90 backdrop-blur-sm rounded w-full">
                        <h3 class="font-headline-md text-headline-md mb-1 text-lg text-white font-bold">Maximiza</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant text-sm">{t('home.maximizaSub')}</p>
                    </div>
                </a>
                
                <!-- Project 3 (2x1) -->
                <a class="bento-card col-span-1 md:col-span-2 lg:col-span-6 p-6 flex flex-col justify-end rounded-lg group relative overflow-hidden h-[240px]" href="https://www.behance.net/gallery/240666733/Novanet-studio-web-app" target="_blank" rel="noopener noreferrer">
                    <div class="absolute inset-0 bg-surface-container-highest opacity-50 transition-opacity group-hover:opacity-30 z-0"></div>
                    <div class="relative z-10 p-4 border border-dim-grey bg-carbon/90 backdrop-blur-sm rounded w-full">
                        <h3 class="font-headline-md text-headline-md mb-1 text-lg text-white font-bold">Novanet Studio</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant text-sm">{t('home.novanetSub')}</p>
                    </div>
                </a>
            </div>
        </section>

        <!-- ZONE 4: THE ACTION CLUSTER -->
        <section class="border-t border-dim-grey pt-12">
            <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-12 gap-gutter">
                <!-- Audit CTA (3x1 equivalent) -->
                <div class="bento-card col-span-1 md:col-span-4 lg:col-span-8 p-12 flex flex-col md:flex-row items-start md:items-center justify-between rounded-lg bg-surface-container-high border-silver">
                    <div class="mb-6 md:mb-0 md:mr-8 max-w-lg">
                        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg mb-4 text-white font-black">{t('home.ctaTitle')}</h2>
                        <p class="font-body-lg text-body-lg text-on-surface-variant">{t('home.ctaDesc')}</p>
                    </div>
                    <a class="whitespace-nowrap inline-flex items-center justify-center bg-primary text-carbon font-body-md text-body-md font-bold px-8 py-4 rounded-lg hover:bg-silver transition-colors" href="mailto:contact@flaex.me">
                        {t('home.ctaButton')}
                    </a>
                </div>
                
                <!-- Social Cluster -->
                <div class="col-span-1 md:col-span-4 lg:col-span-4 flex items-center justify-center gap-6">
                    <a class="w-10 h-10 flex items-center justify-center border border-dim-grey rounded-full text-dim-grey hover:text-white hover:border-white transition-all duration-200" href="https://www.linkedin.com" title="LinkedIn" target="_blank" rel="noopener noreferrer">
                        <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
                        </svg>
                    </a>
                    <a class="w-10 h-10 flex items-center justify-center border border-dim-grey rounded-full text-dim-grey hover:text-white hover:border-white transition-all duration-200" href="https://www.behance.net" title="Behance" target="_blank" rel="noopener noreferrer">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M23.268 14.501h-5.741c.108 1.15.932 1.83 2.144 1.83.993 0 1.638-.403 1.906-1.042h1.564c-.372 1.613-1.802 2.711-3.484 2.711-2.457 0-3.692-1.638-3.692-3.692 0-2.12 1.302-3.792 3.618-3.792 2.219 0 3.685 1.515 3.685 3.985zm-1.613-1.129c-.049-1.004-.719-1.638-2.007-1.638-1.228 0-1.956.634-2.082 1.638h4.089zm-1.65-2.605h-3.409V9.664h3.409v1.103zM11.518 18h-4.33V6h4.156c2.407 0 3.511 1.154 3.511 2.878 0 1.154-.596 2.059-1.662 2.53 1.414.347 2.219 1.488 2.219 3.125C15.412 16.512 14.159 18 11.518 18zm-2.839-1.117h2.518c1.65 0 2.257-.806 2.257-1.996 0-1.228-.608-2.007-2.257-2.007H8.679v4.003zm0-5.116h2.344c1.515 0 2.059-.757 2.059-1.891 0-1.117-.544-1.879-2.059-1.879H8.679v3.77z"></path>
                        </svg>
                    </a>
                    <a class="w-10 h-10 flex items-center justify-center border border-dim-grey rounded-full text-dim-grey hover:text-white hover:border-white transition-all duration-200" href="https://github.com" title="GitHub" target="_blank" rel="noopener noreferrer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                        </svg>
                    </a>
                    <a class="w-10 h-10 flex items-center justify-center border border-dim-grey rounded-full text-dim-grey hover:text-white hover:border-white transition-all duration-200" href="https://x.com" title="X" target="_blank" rel="noopener noreferrer">
                        <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932 6.064-6.932zm-1.292 19.49h2.039L6.486 3.24H4.298l13.311 17.403z"></path>
                        </svg>
                    </a>
                    <a class="w-10 h-10 flex items-center justify-center border border-dim-grey rounded-full text-dim-grey hover:text-white hover:border-white transition-all duration-200" href="https://instagram.com" title="Instagram" target="_blank" rel="noopener noreferrer">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
                            <rect height="20" rx="5" ry="5" width="20" x="2" y="2"></rect>
                            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                        </svg>
                    </a>
                </div>
            </div>
        </section>
    </main>
    
    <Footer />
</Layout>
