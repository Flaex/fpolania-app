    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://fpolania.com/" />
    <meta property="og:title" content="Fredy Polania | Senior Product Strategist" />
    <meta
      property="og:description"
      content="Conectando estrategia de negocio, visión de diseño y technologic craft. Casos de estudio y ejecución orientada a resultados en productos digitales."
    />
    <meta
