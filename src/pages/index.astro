---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="STRATEGIST | @flaex_">
	<Navigation />
	
	<main class="flex-grow w-full max-w-7xl mx-auto px-6 md:px-12 py-12 md:py-24 space-y-24">
		<!-- ZONE 1: THE STRATEGIC CORE -->
		<section>
			<div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-12 gap-6 auto-rows-[minmax(180px,auto)]">
				<!-- Hero (Lg: spans 8 cols, 2 rows) -->
				<div class="bg-carbon border border-dim-grey col-span-1 md:col-span-4 lg:col-span-8 lg:row-span-2 p-8 md:p-12 flex flex-col justify-between rounded-lg relative overflow-hidden group">
					<div class="absolute inset-0 opacity-5 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white to-transparent"></div>
					<div class="relative z-10">
						<p class="font-geist text-[10px] text-dim-grey mb-4 uppercase tracking-[0.3em] font-bold">Executive Summary</p>
						<h1 class="font-fraunces text-4xl md:text-6xl lg:text-7xl mb-6 text-white leading-tight">Senior Product Strategist</h1>
						<p class="font-geist text-lg md:text-xl text-silver max-w-2xl mb-8 font-light">
							Business Strategy. Design Vision. Technical Craft.
						</p>
					</div>
					<div class="relative z-10 mt-auto">
						<a class="inline-flex items-center justify-center bg-white text-carbon font-geist text-xs font-bold uppercase tracking-widest px-8 py-4 rounded-sm hover:bg-alabaster transition-colors" href="#">
							Explore the Command Center 
							<span class="material-symbols-outlined ml-2 text-sm">arrow_forward</span>
						</a>
					</div>
				</div>

				<!-- Latest Insight (2x2 equivalent in 12 col = 4 cols, 2 rows) -->
				<div class="bg-carbon border border-dim-grey col-span-1 md:col-span-2 lg:col-span-4 lg:row-span-2 p-8 flex flex-col justify-between rounded-lg group hover:border-silver transition-colors cursor-pointer">
					<div>
						<div class="flex items-center justify-between mb-6">
							<span class="font-geist text-[10px] text-dim-grey uppercase tracking-widest font-bold">Latest Insight</span>
							<span class="material-symbols-outlined text-dim-grey group-hover:text-white transition-colors">north_east</span>
						</div>
						<h2 class="font-fraunces text-2xl md:text-3xl mb-4 text-white leading-snug">Architecting the Future of Enterprise AI</h2>
						<p class="font-geist text-sm text-silver line-clamp-4 leading-relaxed font-light">
							Moving beyond chat interfaces to deep systemic orchestration. Why the next generation of enterprise value lies in autonomous agentic frameworks rather than simple LLM prompts.
						</p>
					</div>
					<div class="mt-8">
						<a class="text-white border-b border-white pb-1 inline-flex items-center font-geist text-[10px] font-bold uppercase tracking-widest hover:text-silver hover:border-silver transition-colors" href="#">
							Read Article <span class="material-symbols-outlined ml-1 text-sm">arrow_forward</span>
						</a>
					</div>
				</div>

				<!-- Strategic Cards Row -->
				<!-- Authority Stat (3 cols) -->
				<div class="bg-carbon border border-dim-grey col-span-1 md:col-span-1 lg:col-span-3 p-8 flex flex-col justify-center items-center text-center rounded-lg">
					<h3 class="font-fraunces text-6xl text-white mb-2 font-black">15+</h3>
					<p class="font-geist text-[10px] text-dim-grey uppercase tracking-widest font-bold">Years of multi-disciplinary leadership.</p>
				</div>

				<!-- Card 1 (5 cols) -->
				<div class="bg-carbon border border-dim-grey col-span-1 md:col-span-3 lg:col-span-5 p-8 flex flex-col justify-center rounded-lg group hover:bg-[#201F1F] transition-colors">
					<h3 class="font-fraunces text-xl md:text-2xl mb-3 text-white">De-risking the 'Messy Middle.'</h3>
					<p class="font-geist text-sm text-silver leading-relaxed font-light">
						Products fail in the gap between Business, Design, and Tech. I bridge that gap to ensure every line of code is an investment in your bottom line.
					</p>
				</div>

				<!-- Card 2 (4 cols) -->
				<div class="bg-carbon border border-dim-grey col-span-1 md:col-span-4 lg:col-span-4 p-8 flex flex-col justify-center rounded-lg group hover:bg-[#201F1F] transition-colors">
					<h3 class="font-fraunces text-xl md:text-2xl mb-3 text-white">Created by People. Refined with AI.</h3>
					<p class="font-geist text-sm text-silver leading-relaxed font-light">
						Leveraging LLMs and CLI-based orchestration to amplify senior craft and accelerate speed-to-market.
					</p>
				</div>
			</div>
		</section>

		<!-- ZONE 2: FEATURED WORKS -->
		<section>
			<div class="flex items-center justify-between mb-12 border-b border-dim-grey pb-6">
				<h2 class="font-fraunces text-3xl md:text-5xl text-white">Featured Works</h2>
				<a class="font-geist text-[10px] text-dim-grey hover:text-white transition-colors flex items-center font-bold uppercase tracking-widest" href="#">
					View All <span class="material-symbols-outlined ml-2 text-sm">arrow_forward</span>
				</a>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-12 gap-6 auto-rows-[minmax(240px,auto)]">
				<!-- Project 1 (6 cols, 2 rows) -->
				<a class="bg-carbon border border-dim-grey col-span-1 md:col-span-4 lg:col-span-6 lg:row-span-2 p-8 flex flex-col justify-end rounded-lg group relative overflow-hidden min-h-[400px]" href="#">
					<div class="absolute inset-0 bg-dim-grey opacity-10 group-hover:opacity-20 transition-opacity z-0">
						<img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBt3gEJY9r3hNhyV7Ms2ePpSGcVd2e1A-eD0nt3n8EWGYOqiw-zMHz43OtmUh9PPb7pqRIf6aHATny4LqnhoGmBh9na7iQVZJQf3O4F7Swga5tJ8sqOKVLcsNgo9bhx-w5SxWjSPxCnwsvTRJVM6Z9xo2tS8IXtmThTcKTuE7DK1r3iWrefpGj75tly-Kz_b7CnbZwRpk3ZVWRqtoFX9OVHxfl8uBsKkhEZKSExcu-I-xcNELV5UlQLjLuk6wELbSxNwhzy98MtgzqE" alt="Banco del Libro" class="w-full h-full object-cover grayscale opacity-50 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700" />
					</div>
					<div class="relative z-10 p-6 bg-carbon/80 backdrop-blur-md border border-white/10 rounded-sm">
						<h3 class="font-fraunces text-2xl mb-2 text-white">Banco del Libro</h3>
						<p class="font-geist text-xs text-silver uppercase tracking-widest">Selected Participant, Bienal Iberoamericana de Diseño (BID)</p>
					</div>
				</a>
				<!-- Project 2 (6 cols, 1 row) -->
				<a class="bg-carbon border border-dim-grey col-span-1 md:col-span-2 lg:col-span-6 p-8 flex flex-col justify-end rounded-lg group relative overflow-hidden min-h-[240px]" href="#">
					<div class="absolute inset-0 bg-dim-grey opacity-5 group-hover:opacity-10 transition-opacity z-0"></div>
					<div class="relative z-10 w-full">
						<div class="flex justify-between items-start mb-4">
							<h3 class="font-fraunces text-2xl text-white">Maximiza</h3>
							<span class="material-symbols-outlined text-dim-grey group-hover:text-white transition-colors">arrow_outward</span>
						</div>
						<p class="font-geist text-xs text-silver uppercase tracking-widest">Branding & Web for a financial services leader</p>
					</div>
				</a>
				<!-- Project 3 (6 cols, 1 row) -->
				<a class="bg-carbon border border-dim-grey col-span-1 md:col-span-2 lg:col-span-6 p-8 flex flex-col justify-end rounded-lg group relative overflow-hidden min-h-[240px]" href="#">
					<div class="absolute inset-0 bg-dim-grey opacity-5 group-hover:opacity-10 transition-opacity z-0"></div>
					<div class="relative z-10 w-full">
						<div class="flex justify-between items-start mb-4">
							<h3 class="font-fraunces text-2xl text-white">Novanet Studio</h3>
							<span class="material-symbols-outlined text-dim-grey group-hover:text-white transition-colors">arrow_outward</span>
						</div>
						<p class="font-geist text-xs text-silver uppercase tracking-widest">Architecting high-performance ecosystems</p>
					</div>
				</a>
			</div>
		</section>

		<!-- ZONE 4: THE ACTION CLUSTER -->
		<section class="border-t border-white/10 pt-24">
			<div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-12 gap-6">
				<!-- Audit CTA (8 cols) -->
				<div class="bg-carbon border border-dim-grey col-span-1 md:col-span-4 lg:col-span-8 p-12 flex flex-col md:flex-row items-start md:items-center justify-between rounded-lg bg-gradient-to-br from-carbon to-[#201F1F]">
					<div class="mb-8 md:mb-0 md:mr-12 max-w-lg">
						<h2 class="font-fraunces text-3xl md:text-5xl mb-4 text-white leading-tight">Let's Build Together.</h2>
						<p class="font-geist text-lg text-silver font-light">Available for strategic product audits and architectural consulting.</p>
					</div>
					<a class="whitespace-nowrap inline-flex items-center justify-center bg-white text-carbon font-geist text-xs font-bold uppercase tracking-widest px-10 py-5 rounded-sm hover:bg-alabaster transition-colors shadow-2xl" href="mailto:contact@flaex.me">
						Request an Audit
					</a>
				</div>
				<!-- Social Cluster (4 cols) -->
				<div class="col-span-1 md:col-span-4 lg:col-span-4 flex items-center justify-center gap-8 md:gap-4 lg:gap-8">
					<a href="#" class="w-14 h-14 flex items-center justify-center border border-dim-grey rounded-full text-dim-grey hover:text-white hover:border-white transition-all duration-300" title="LinkedIn">
						<span class="material-symbols-outlined">work</span>
					</a>
					<a href="#" class="w-14 h-14 flex items-center justify-center border border-dim-grey rounded-full text-dim-grey hover:text-white hover:border-white transition-all duration-300" title="Behance">
						<span class="material-symbols-outlined">palette</span>
					</a>
					<a href="#" class="w-14 h-14 flex items-center justify-center border border-dim-grey rounded-full text-dim-grey hover:text-white hover:border-white transition-all duration-300" title="GitHub">
						<span class="material-symbols-outlined">code</span>
					</a>
					<a href="#" class="w-14 h-14 flex items-center justify-center border border-dim-grey rounded-full text-dim-grey hover:text-white hover:border-white transition-all duration-300" title="X">
						<span class="material-symbols-outlined">alternate_email</span>
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
