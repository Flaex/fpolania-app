    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:alt" content="Fredy Polania — Senior Product Strategist" />
    <meta property="og:site_name" content="Fredy Polania" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Flaex_" />
    <meta name="twitter:creator" content="@Flaex_" />
    <meta name="twitter:url" content="https://fpolania.com/" />
    <meta name="twitter:title" content="Fredy Polania | Senior Product Strategist" />
    <meta
      name="twitter:description"
      content="Conectando estrategia de negocio, visión de diseño y technologic craft. Casos de estudio y ejecución orientada a resultados en productos digitales."
    />
    <meta
      name="twitter:image"
      content="https://fpolania.com/fpolania-site-og.webp"
    />
    <meta name="twitter:image:alt" content="Fredy Polania — Senior Product Strategist" />

    <!-- SEO Indexing & Crawlers -->
    <link rel="alternate" hreflang="en" href="https://fpolania.com/en/" />
    <link rel="alternate" hreflang="es" href="https://fpolania.com/es/" />
    <link rel="alternate" hreflang="x-default" href="https://fpolania.com/" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "https://fpolania.com/#website",
            "url": "https://fpolania.com/",
            "name": "Fredy Polania",
            "description": "Conectando estrategia de negocio, visión de diseño y technologic craft.",
            "publisher": {
              "@id": "https://fpolania.com/#person"
            },
            "inLanguage": ["es", "en"]
          },
          {
            "@type": "Person",
            "@id": "https://fpolania.com/#person",
            "name": "Fredy Polania",
            "url": "https://fpolania.com/",
            "jobTitle": "Senior Product Strategist",
            "sameAs": [
              "https://www.linkedin.com/in/freddypolania/",
              "https://www.behance.net/fredypolania",
              "https://x.com/Flaex_"
            ],
            "image": "https://fpolania.com/fpolania-site-og.webp",
            "description": "Conectando estrategia de negocio, visión de diseño y arquitectura frontend."
          }
        ]
      }
    </script>

    <!-- Language & Location Detection Script -->
    <script is:inline>
      (function () {
        try {
          // 1. Check local storage preference
          const cachedLang = localStorage.getItem("preferred-lang");
          if (cachedLang === "en" || cachedLang === "es") {
            window.location.replace("/" + cachedLang + "/");
            return;
          }

          // 2. Check browser language settings
          const browserLangs = navigator.languages || [
            navigator.language || navigator.userLanguage,
          ];
          for (let i = 0; i < browserLangs.length; i++) {
            const l = browserLangs[i].toLowerCase();
            if (l.startsWith("es")) {
              window.location.replace("/es/");
              return;
            }
            if (l.startsWith("en")) {
              window.location.replace("/en/");
              return;
            }
          }

          // 3. Fallback: Timezone-based country locale approximation
          const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || "";
          const esCities = [
            "Madrid",
            "Bogota",
            "Mexico",
            "Buenos_Aires",
            "Caracas",
            "Lima",
            "Santiago",
            "Quito",
            "Montevideo",
            "Asuncion",
            "La_Paz",
            "Guatemala",
            "Tegucigalpa",
            "San_Salvador",
            "Managua",
            "San_Jose",
            "Panama",
            "Havana",
            "Santo_Domingo",
            "Puerto_Rico",
          ];

          const isSpanishTz = esCities.some((city) => tz.includes(city));
          if (isSpanishTz) {
            window.location.replace("/es/");
            return;
          }
        } catch (e) {
          console.error("Localization routing error:", e);
        }

        // 4. Ultimate default: English
        window.location.replace("/en/");
      })();
    </script>

    <style>
      body {
        background-color: #1a1b1a;
        color: #e0e0e0;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        margin: 0;
      }
      .container {
        text-align: center;
        padding: 2rem;
        border: 1px solid #666666;
        border-radius: 8px;
        max-width: 400px;
      }
      h1 {
        font-size: 1.5rem;
        margin: 0 0 1rem;
        color: #ffffff;
      }
      a {
        color: #ffffff;
        text-decoration: none;
        border-bottom: 1px solid #ffffff;
        margin: 0 10px;
        font-weight: bold;
      }
      a:hover {
        color: #c0c0c0;
        border-color: #c0c0c0;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Fredy Polania</h1>
      <p>
        Redirecting to your preferred language / Redireccionando a su idioma de
        preferencia...
      </p>
      <noscript>
        <p>Please select / Por favor seleccione:</p>
        <a href="/en/">English</a>
        <a href="/es/">Español</a>
      </noscript>
    </div>
  </body>
</html>
