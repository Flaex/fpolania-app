---
import '../styles/global.css';
import { getAlternatePath } from '../utils/i18n';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
	lang?: string;
	image?: string;
	type?: 'website' | 'article';
	schema?: Record<string, any>;
}

const { 
	title, 
	description = "Senior Product Strategist bridging Business Strategy, Design Vision, and Technologic craft. Outcome-driven execution across digital products.", 
	lang = "en",
	image = "/fpolania-site-og.webp",
	type = "website",
	schema
} = Astro.props;

const alternateLang = lang === 'en' ? 'es' : 'en';
const alternatePath = getAlternatePath(Astro.url.pathname, alternateLang);

const canonicalBase = "https://fpolania.com";
const canonicalUrl = `${canonicalBase}${Astro.url.pathname}`;
const ogImage = image.startsWith('http') ? image : `${canonicalBase}${image}`;

const gaId = import.meta.env.PUBLIC_GA_ID;

const defaultSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": "https://fpolania.com/#website",
			"url": "https://fpolania.com/",
			"name": "Fredy Polania",
			"description": lang === 'es' 
				? "Conectando estrategia de negocio, visión de diseño y technologic craft."
				: "Senior Product Strategist bridging Business Strategy, Design Vision, and Technologic craft.",
			"publisher": {
				"@id": "https://fpolania.com/#person"
			},
			"inLanguage": ["es", "en"]
		},
		{
			"@type": "Person",
			"@id": "https://fpolania.com/#person",
			"name": "Fredy Polania",
			"url": "https://fpolania.com/",
			"jobTitle": "Senior Product Strategist",
			"sameAs": [
				"https://www.linkedin.com/in/freddypolania/",
				"https://www.behance.net/fredypolania",
				"https://x.com/Flaex_"
			],
			"image": `${canonicalBase}/fpolania-site-og.webp`,
			"description": lang === 'es'
				? "Conectando estrategia de negocio, visión de diseño y arquitectura frontend."
				: "Bridging business strategy, design vision, and front-end technologic craft."
		}
	]
};

const finalSchema = schema || defaultSchema;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1A1B1A" />
		<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalUrl} />

		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(finalSchema)} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${title} — Fredy Polania`} />
		<meta property="og:site_name" content="Fredy Polania" />
		<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
		<meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@Flaex_" />
		<meta name="twitter:creator" content="@Flaex_" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={`${title} — Fredy Polania`} />
		<link id="legacy-favicon" rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link id="dynamic-favicon" rel="icon" type="image/svg+xml" href="/favicon-dark.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<!-- FOUC Prevention: resolve theme and favicon before first paint -->
		<script is:inline>
			(function() {
				var theme = 'dark';
				try { theme = localStorage.getItem('theme') || 'dark'; } catch(e) {}
				var d = document.documentElement;
				if (theme === 'light') {
					d.classList.add('light');
					d.classList.remove('dark');
				} else {
					d.classList.add('dark');
					d.classList.remove('light');
				}
				// Remove legacy favicon to force browser to use the dynamic SVG icon
				var legacy = document.getElementById('legacy-favicon');
				if (legacy && legacy.parentNode) {
					legacy.parentNode.removeChild(legacy);
				}
				// Set favicon to match the resolved theme with a cache-buster
				var favicon = document.getElementById('dynamic-favicon');
				if (favicon) {
					var href = theme === 'light' ? '/favicon-light.svg' : '/favicon-dark.svg';
					favicon.href = href + '?t=' + new Date().getTime();
				}
			})();
		</script>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
		<link rel="alternate" hreflang={lang} href={`https://fpolania.com${Astro.url.pathname}`} />
		<link rel="alternate" hreflang={alternateLang} href={`https://fpolania.com${alternatePath}`} />

		<!-- PWA & Mobile Web App Capabilities -->
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content="#1A1B1A" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<script>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js')
						.then(reg => {
							console.log('ServiceWorker registered with scope: ', reg.scope);
						})
						.catch(err => {
							console.error('ServiceWorker registration failed: ', err);
						});
				});
			}
		</script>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700;9..144,900&family=Geist:wght@100..900&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

		<!-- Google Analytics (Google Tag) -->
		{gaId && (
			<>
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
				<script is:inline set:html={`
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());

					gtag('config', '${gaId}');

					document.addEventListener('astro:page-load', () => {
						if (typeof gtag === 'function') {
							gtag('config', '${gaId}', {
								page_path: window.location.pathname,
								page_title: document.title
							});
						}
					});
				`} />
			</>
		)}
	</head>
	<body class="bg-background text-on-background selection:bg-silver selection:text-carbon overflow-x-hidden transition-colors duration-300">
		<slot />
	</body>
</html>

<style is:global>
	@reference "../styles/global.css";

	:root {
		--accent: 136, 58, 234;
		--accent-light: 224, 204, 250;
		--accent-dark: 49, 10, 101;
		--accent-gradient: linear-gradient(
			45deg,
			rgb(var(--accent)),
			rgb(var(--accent-light)) 30%,
			white 60%
		);
	}
	
	.material-symbols-outlined {
		font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
		display: inline-block;
		vertical-align: middle;
	}

	.bento-card {
		@apply bg-surface-container border border-outline-variant transition-all duration-300;
	}
	
	.bento-card:hover {
		@apply border-primary;
	}
</style>
